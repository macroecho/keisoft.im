{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",

  // 可选：MySql、SqlServer
  "DatabaseProvider": "MySql",

  "ConnectionStrings": {
    "MySql": "Server=mysql;Port=3306;Uid=root;Pwd=example@123;DataBase=keisoft_im;CharSet=utf8mb4;",
    "SqlServer": "Data Source=sqlserver;Initial Catalog=Keisoft.IM;Uid=example;Pwd=example@123;TrustServerCertificate=true;"
  },

  // 身份验证配置。
  "AuthenticationSettings": {
    // API Key 认证，适用于内部系统，通过密钥实现身份确认。
    "ApiKeyToken": "JZu3njkd82WISwiAjchYwK75RX9BOmqu"
  },

  // 客户端用户的身份令牌验证秘钥。
  "TokeValidateSecretKey": "YnU6S1Nq1zgT21lFVe+Haw==",

  // 长连接服务外网地址（Keisoft.IM.Server.Activity 程序外网 IP 与端口），集群配置多个。
  "TcpServiceAddress": [ "192.168.1.21:18168" ],
  // 长连接服务的集群节点编号
  "TcpServiceNodeId": [ 18168 ],

  "IMSdkOptions": {
    // 系统用户身份令牌，可以使用 IIdentityService.Create 生成
    "Token": "3whcdErwuZOSCiLS5myeBA==",
    // Keisoft.IM.Server.Activity 程序的 IP 地址，如果和当前程序在同一个内网，使用内网地址更高效。
    "ServerHost": "keisoft-im-server",
    "ServerPort": 18168,
    // 系统用户标识，主要用于给用户发送通知，可让客户端知道消息来自系统用户。
    "SysUserUnique": 1,
    // TCP 通讯安全公钥证书文件（TCP 服务私钥中的公钥文件）。
    "CertificateFileName": "demo.crt",
    // 消息内容加解密的密钥（128-bit / 16 bytes）
    "MessageContentSecretKey": "CGkJri5mbIo9VGxogWwVig=="
  },

  // Redis 配置。
  "RedisOptions": {
    // 集群必须至少 2~3 个节点。
    "EndPoints": [
      "redis:6379"
    ],
    "Password": "",
    // 单机可以允许连接失败时中断，集群必须设为 false。
    "AbortOnConnectFail": true,
    // 启用加密传输为 true。
    "Ssl": false
    //// 连接超时（单位：毫秒）。
    //"ConnectTimeout": 10000,
    //// 连接重试次数。
    //"ConnectRetry": 5
  }
}
